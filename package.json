{
  "name": "retris",
  "private": true,
  "description": "A competitive line-sprint Tetris-style game with accounts, server-verified times, and full replays, built on Remix 3.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --import remix/node-tsx server.ts",
    "start": "node --env-file-if-exists=.env --import remix/node-tsx server.ts",
    "migrate": "node --env-file-if-exists=.env --import remix/node-tsx --eval \"import('./app/data/db.ts').then(m => m.migrate()).then(() => console.log('migrations applied'))\"",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "test": "NODE_ENV=test remix test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "libsql": "^0.5.29",
    "lucide-remix": "^0.0.5",
    "remix": "3.0.0-beta.5"
  },
  "devDependencies": {
    "@types/node": "latest",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "playwright": "^1.61.0",
    "typescript": "latest"
  },
  "engines": {
    "node": ">=24.3.0"
  }
}
