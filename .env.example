# Copy to .env and fill in. When TURSO_DATABASE_URL is unset the app falls back
# to the local db/retris.sqlite file. Tests always use an in-memory database.
TURSO_DATABASE_URL=libsql://<database>-<org>.<region>.turso.io
TURSO_AUTH_TOKEN=

# Required in production for signed session cookies.
SESSION_SECRET=

# Public site URL for canonical links, sitemap, and password-reset emails.
APP_URL=

# Outbound mail via Resend (https://resend.com). Verify retris.world in Resend,
# then add their DNS records in Namecheap. When unset, reset emails are not sent.
RESEND_API_KEY=
MAIL_FROM=noreply@retris.world

# Username of the admin account. Required in production (the app refuses to
# boot without it); dev/test fall back to admin@example.test.
ADMIN_USERNAME=
